{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": ["./*"],
			"@earendil-works/chord": ["./packages/chord/src/index.ts"],
			"@earendil-works/chord/bundler": ["./packages/chord/src/bundler.ts"],
			"@earendil-works/chord/context": ["./packages/chord/src/context/index.ts"],
			"@earendil-works/chord/delta": ["./packages/chord/src/delta/index.ts"],
			"@earendil-works/chord/node": ["./packages/chord/src/node.ts"],
			"@tangent-ai/tangent-telemetry": ["./packages/telemetry/src/index.ts"],
			"@tangent-ai/tangent-telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@tangent-ai/tangent-ai": ["./packages/ai/src/index.ts"],
			"@tangent-ai/tangent-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@tangent-ai/tangent-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@tangent-ai/tangent-ai/dist/*": ["./packages/ai/src/*"],
			"@tangent-ai/tangent-agent-core": ["./packages/agent/src/index.ts"],
			"@tangent-ai/tangent-agent-core/harness/session/testing": [
				"./packages/agent/src/harness/session/testing/index.ts"
			],
			"@tangent-ai/tangent-agent-core/node": ["./packages/agent/src/node.ts"],
			"@tangent-ai/tangent-agent-core/*": [
				"./packages/agent/src/*.ts",
				"./packages/agent/src/*/index.ts",
				"./packages/agent/src/*"
			],
			"@tangent-ai/tangent-session-backend-sqlite-node": ["./packages/session-backends/sqlite-node/src/index.ts"],
			"@tangent-ai/tangent-coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@tangent-ai/tangent-coding-agent/experimental/plugin": [
				"./packages/coding-agent/src/experimental/plugin.ts"
			],
			"@tangent-ai/tangent-coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@tangent-ai/tangent-coding-agent/*": ["./packages/coding-agent/src/*"],
			"@tangent-ai/tangent-protocol": ["./packages/protocol/src/index.ts"],
			"@tangent-ai/tangent-protocol/*": ["./packages/protocol/src/*"],
			"@tangent-ai/tangent-client": ["./packages/client/src/index.ts"],
			"@tangent-ai/tangent-client/unix": ["./packages/client/src/unix.ts"],
			"@tangent-ai/tangent-client/*": ["./packages/client/src/*"],
			"@tangent-ai/tangent-server": ["./packages/server/src/index.ts"],
			"@tangent-ai/tangent-server/unix": ["./packages/server/src/transports/unix/index.ts"],
			"@tangent-ai/tangent-server/*": ["./packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@tangent-ai/tangent-tui": ["./packages/tui/src/index.ts"],
			"@tangent-ai/tangent-tui/*": ["./packages/tui/src/*"],
			"@tangent-ai/tangent-agent-old": ["./packages/agent-old/src/index.ts"],
			"@tangent-ai/tangent-agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/session-backends/*/src/**/*", "packages/session-backends/*/test/**/*", "packages/coding-agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
